{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "isolatedModules": true,
    "declaration": true,
    "types": ["@types/node", "@types/jest"],
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
